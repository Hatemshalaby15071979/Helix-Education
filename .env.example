# Helix-Education environment template
# Copy to .env and fill in real values. Never commit .env.
# Every variable below is read by the code; names and defaults come from source.

# --- Grounding engine (grounding_engine/grounding_client.py) ---
# REQUIRED when the grounding client is used; raises ValueError if unset/empty.
HELIX_GROUNDING_API_URL=
# Optional bearer token: Authorization: Bearer <key>
HELIX_GROUNDING_API_KEY=
# Optional positive integer seconds. Default: 15.
HELIX_GROUNDING_TIMEOUT_SECONDS=15

# --- Sealed answer-key store (state_core/event_store.py) ---
# Optional override for the sealed answer-key JSONL path.
# Default: <XDG_DATA_HOME or ~/.local/share>/helix-education/sealed_answer_keys.jsonl
# Windows: %LOCALAPPDATA%/helix-education/sealed_answer_keys.jsonl
HELIX_SEALED_KEY_PATH=

# --- Ollama LLM backend (helix_education/web_server_v2.py, cli.py) ---
# Model name is a constant in web_server_v2.py (OLLAMA_MODEL).
# Ollama reads OLLAMA_HOST from the environment. Default: http://127.0.0.1:11434
OLLAMA_HOST=http://127.0.0.1:11434
